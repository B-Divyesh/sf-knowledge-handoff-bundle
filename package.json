{
  "name": "knowledge-handoff-bundle-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:site": "vite build",
    "build:demo": "sh scripts/build-demo.sh",
    "build": "cargo build --release --locked && npm run build:demo && npm run build:site",
    "test": "cargo test --locked && node --test tests/*.test.mjs",
    "audit:a11y": "node scripts/a11y.mjs http://127.0.0.1:4173",
    "package": "cargo package --locked --allow-dirty"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "1.58.2",
    "vite": "^8.2.2"
  }
}
